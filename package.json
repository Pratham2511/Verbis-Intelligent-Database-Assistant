{
  "name": "verbis-db-assistant",
  "displayName": "Verbis — Intelligent Database Assistant",
  "description": "Talk to any database in plain English. Verbis converts natural language into optimized SQL and NoSQL queries, explains results, tracks query history, and protects your data — all inside VS Code.",
  "version": "1.2.6",
  "publisher": "pratham2511",
  "icon": "media/icon.png",
  "license": "MIT",
  "private": false,
  "repository": {
    "type": "git",
    "url": "https://github.com/Pratham2511/Verbis-Intelligent-Database-Assistant"
  },
  "bugs": {
    "url": "https://github.com/Pratham2511/Verbis-Intelligent-Database-Assistant/issues"
  },
  "homepage": "https://github.com/Pratham2511/Verbis-Intelligent-Database-Assistant#readme",
  "categories": [
    "AI",
    "Data Science",
    "Other"
  ],
  "keywords": [
    "sql",
    "database",
    "ai",
    "natural language",
    "gemini",
    "postgresql",
    "mysql",
    "mongodb",
    "query",
    "nlp",
    "text-to-sql",
    "nl2sql",
    "database assistant"
  ],
  "engines": {
    "vscode": "^1.85.0"
  },
  "galleryBanner": {
    "color": "#0A0F1E",
    "theme": "dark"
  },
  "main": "./out/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "verbis-explorer",
          "title": "Verbis",
          "icon": "media/sidebar.svg"
        }
      ]
    },
    "views": {
      "verbis-explorer": [
        {
          "id": "verbis.connections",
          "name": "Connections"
        },
        {
          "id": "verbis.schema",
          "name": "Schema"
        },
        {
          "id": "verbis.history",
          "name": "Recent Queries"
        }
      ]
    },
    "commands": [
      {
        "command": "verbis.openAssistant",
        "title": "Verbis: Open Assistant",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "verbis.installBackend",
        "title": "Verbis: Install / Reinstall Backend"
      },
      {
        "command": "verbis.selectConnection",
        "title": "Verbis: Select Database Connection"
      },
      {
        "command": "verbis.setApiKey",
        "title": "Verbis: Set API Key"
      },
      {
        "command": "verbis.clearApiKey",
        "title": "Verbis: Remove API Key"
      },
      {
        "command": "verbis.showSchema",
        "title": "Verbis: Show Schema & ER Diagram"
      },
      {
        "command": "verbis.openTree",
        "title": "Verbis: Open Query Tree"
      },
      {
        "command": "verbis.runLastQuery",
        "title": "Verbis: Run Last Query"
      },
      {
        "command": "verbis.addConnection",
        "title": "Verbis: Add Database Connection"
      },
      {
        "command": "verbis.runRobustnessTest",
        "title": "Verbis: Run Schema Evolution Robustness Test"
      },
      {
        "command": "verbis.restartBackend",
        "title": "Verbis: Restart Python Backend"
      },
      {
        "command": "verbis.openGlossaryEditor",
        "title": "Verbis: Open Business Glossary Editor"
      }
    ],
    "keybindings": [
      {
        "command": "verbis.openAssistant",
        "key": "ctrl+shift+q",
        "mac": "cmd+shift+q"
      },
      {
        "command": "verbis.runLastQuery",
        "key": "ctrl+shift+r",
        "mac": "cmd+shift+r"
      },
      {
        "command": "verbis.showSchema",
        "key": "ctrl+shift+s",
        "mac": "cmd+shift+s"
      },
      {
        "command": "verbis.openTree",
        "key": "ctrl+shift+t",
        "mac": "cmd+shift+t"
      }
    ],
    "configuration": {
      "title": "Verbis",
      "properties": {
        "verbis.llm.provider": {
          "type": "string",
          "enum": [
            "gemini",
            "groq",
            "local"
          ],
          "default": "gemini",
          "description": "LLM provider. Gemini recommended — free tier at aistudio.google.com."
        },
        "verbis.llm.geminiModel": {
          "type": "string",
          "default": "gemini-3.6-flash",
          "description": "Gemini model to use. Default is gemini-3.6-flash. Note: gemini-2.5-flash and earlier 2.x/1.x models were retired by Google for new users."
        },
        "verbis.llm.groqModel": {
          "type": "string",
          "default": "llama-3.3-70b-versatile",
          "description": "Groq model to use when provider is groq."
        },
        "verbis.privacy.enableShield": {
          "type": "boolean",
          "default": true,
          "description": "Anonymize schema names before sending to cloud LLM."
        },
        "verbis.query.rowLimit": {
          "type": "number",
          "default": 500,
          "minimum": 10,
          "maximum": 10000,
          "description": "Maximum rows returned per query."
        },
        "verbis.execution.timeoutSeconds": {
          "type": "number",
          "default": 60,
          "description": "Query execution timeout in seconds."
        },
        "verbis.execution.readOnlyByDefault": {
          "type": "boolean",
          "default": true,
          "description": "Block INSERT / UPDATE / DELETE / DROP unless write mode explicitly enabled."
        },
        "verbis.backend.startPort": {
          "type": "number",
          "default": 8765,
          "description": "First port to attempt for the Python backend."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile && npm run build:webview",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "build:webview": "cd webview && npm run build",
    "watch:webview": "cd webview && npm run dev",
    "lint": "eslint src --ext ts",
    "test": "vitest run",
    "package": "vsce package --no-yarn"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.57.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0",
    "@vscode/test-cli": "^0.0.9",
    "@vscode/test-electron": "^2.4.0"
  }
}
